{
  "allowed": [
    "src/**",
    "docs/**",
    "README.md",
    "RELEASES.md",
    "USAGE.md",
    ".speakeasy/gen.lock",
    ".speakeasy/workflow.lock"
  ],
  "versionOnly": [
    ".speakeasy/gen.yaml"
  ],
  "manifests": [
    "composer.json"
  ],
  "manifestDependencyFields": [
    "require",
    "require-dev"
  ],
  "blocked": [
    ".github/**",
    ".speakeasy/workflow.yaml",
    ".speakeasy/scripts/**",
    "scripts/**",
    ".genignore",
    ".gitattributes",
    "src/Hooks/**",
    "src/Webhooks.php",
    "Tests/**"
  ]
}
