{
  "baseBranch": "main",
  "prAuthor": "github-actions[bot]",
  "branchPrefix": "speakeasy-sdk-regen-",
  "pushActors": [
    "speakeasy-github[bot]"
  ],
  "commitAuthors": [
    "speakeasybot",
    "speakeasy-github[bot]"
  ],
  "allowed": [
    "src/**",
    "docs/**",
    "README.md",
    "RELEASES.md",
    "USAGE.md",
    ".speakeasy/gen.lock",
    ".speakeasy/workflow.lock"
  ],
  "versionOnly": [
    ".speakeasy/gen.yaml",
    "composer.json"
  ],
  "blocked": [
    ".github/**",
    ".speakeasy/workflow.yaml",
    ".speakeasy/scripts/**",
    "scripts/**",
    ".genignore",
    ".gitattributes",
    "src/Hooks/**",
    "src/Webhooks.php",
    "Tests/**"
  ]
}
