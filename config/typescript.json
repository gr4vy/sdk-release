{
  "baseBranch": "main",
  "prAuthor": "gr4vy-sdk-generate[bot]",
  "branchPrefix": "speakeasy-sdk-regen-",
  "pushActors": [
    "gr4vy-sdk-generate[bot]"
  ],
  "commitAuthors": [
    "speakeasybot"
  ],
  "allowed": [
    "src/**",
    "examples/**",
    "FUNCTIONS.md",
    "docs/**",
    "README.md",
    "RELEASES.md",
    "USAGE.md",
    ".speakeasy/gen.lock",
    ".speakeasy/workflow.lock"
  ],
  "versionOnly": [
    ".speakeasy/gen.yaml",
    "package.json",
    "package-lock.json",
    "jsr.json",
    "examples/package.json",
    "examples/package-lock.json"
  ],
  "blocked": [
    ".github/**",
    ".speakeasy/workflow.yaml",
    ".speakeasy/scripts/**",
    "scripts/**",
    ".genignore",
    ".gitattributes",
    "src/hooks/**",
    "src/lib/webhooks.ts",
    "tests/**",
    ".npmignore"
  ]
}
